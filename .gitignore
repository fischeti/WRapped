# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# The config.toml file is not tracked since it can contain sensitive data such as username, password
config.toml
# Only written when `--stats-file` asks for it
stats.json
shared/
.vscode/launch.json
